#!/bin/bash
# Bubblecast for Mac build script.
#
#   bash macos/build.command           Build for this Mac, install to ~/Applications, and launch.
#   bash macos/build.command test      Run the pure-logic self-checks.
#   bash macos/build.command package   Build a universal (Intel + Apple Silicon) app and dist/Bubblecast-<version>.dmg.
#                                      Does not install or launch anything. Used by GitHub Actions.
set -euo pipefail

MODE="${1:-install}"
SOURCE_DIR="$(cd "$(dirname "$0")" && pwd)"
REPOSITORY_ROOT="$(cd "$SOURCE_DIR/.." && pwd)"
APP_VERSION="$(tr -d '[:space:]' < "$REPOSITORY_ROOT/VERSION")"
if [ -z "$APP_VERSION" ]; then
    echo "Could not read the app version from the repository-root VERSION file." >&2
    exit 1
fi
BUILD_TEMP="$(mktemp -d "${TMPDIR:-/tmp}/bubblecast-build.XXXXXX")"
trap 'rm -rf "$BUILD_TEMP"' EXIT

case "$MODE" in
    install|test|package) ;;
    *) echo "Usage: bash macos/build.command [install|test|package]" >&2; exit 2 ;;
esac

if [ "$MODE" = "test" ]; then
    echo "Running Bubblecast pure-logic checks…"
    swiftc -O -framework Foundation -framework CryptoKit -framework Security -o "$BUILD_TEMP/CoreChecks" \
        "$SOURCE_DIR/Tests/CoreChecks.swift" \
        "$SOURCE_DIR/Sources/Core/KeychainTokenStore.swift" \
        "$SOURCE_DIR/Sources/Core/RelaySettings.swift" \
        "$SOURCE_DIR/Sources/Core/RelayProtocol.swift" \
        "$SOURCE_DIR/Sources/Core/TimestampDecoder.swift" \
        "$SOURCE_DIR/Sources/Core/DeliveryQueue.swift"
    "$BUILD_TEMP/CoreChecks"
    exit 0
fi

# ---------------------------------------------------------------------------
# Assemble the app bundle in a staging directory.
# ---------------------------------------------------------------------------
STAGE_APP="$BUILD_TEMP/Bubblecast.app"
CONTENTS="$STAGE_APP/Contents"
MACOS_DIR="$CONTENTS/MacOS"
RESOURCES_DIR="$CONTENTS/Resources"
ICONSET_DIR="$BUILD_TEMP/AppIcon.iconset"
mkdir -p "$MACOS_DIR" "$RESOURCES_DIR" "$ICONSET_DIR"

cat > "$CONTENTS/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleExecutable</key><string>Bubblecast</string>
    <key>CFBundleIdentifier</key><string>local.bubblecast</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleName</key><string>Bubblecast</string>
    <key>CFBundleDisplayName</key><string>Bubblecast</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$APP_VERSION</string>
    <key>CFBundleVersion</key><string>$APP_VERSION</string>
    <key>LSMinimumSystemVersion</key><string>15.0</string>
    <key>LSUIElement</key><true/>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Send new-message alerts and optional text previews to your paired Windows PC on your local network.</string>
    <key>NSContactsUsageDescription</key>
    <string>Match an incoming Messages sender address to a contact name for the Windows notification.</string>
    <key>NSAppTransportSecurity</key>
    <dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict>
</plist>
PLIST

# Brand icon master, generated by tools/BrandIcon.cs (shared with the Windows .ico).
cp "$SOURCE_DIR/Resources/AppIcon-1024.png" "$BUILD_TEMP/AppIcon.png"
for spec in "16 16" "16 32" "32 32" "32 64" "128 128" "128 256" "256 256" "256 512" "512 512" "512 1024"; do
    set -- $spec
    base="$1"
    pixels="$2"
    suffix=""
    if [ "$pixels" -eq $((base * 2)) ]; then suffix="@2x"; fi
    sips -z "$pixels" "$pixels" "$BUILD_TEMP/AppIcon.png" --out "$ICONSET_DIR/icon_${base}x${base}${suffix}.png" >/dev/null
done
iconutil -c icns "$ICONSET_DIR" -o "$RESOURCES_DIR/AppIcon.icns"
if [ ! -s "$RESOURCES_DIR/AppIcon.icns" ]; then
    echo "App icon generation failed: AppIcon.icns is missing or empty." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Compile. Install mode builds for this Mac; package mode builds a universal binary.
# ---------------------------------------------------------------------------
cat > "$BUILD_TEMP/BuildVersion.swift" <<SWIFT
enum RelayBuildInfo { static let version = "$APP_VERSION" }
SWIFT

compile_for() {
    swiftc -parse-as-library -O -target "$1-apple-macosx15.0" \
        -framework AppKit -framework SwiftUI -framework Combine -framework Contacts -framework CryptoKit -framework ServiceManagement -framework Security -lsqlite3 \
        -o "$2" "$BUILD_TEMP/BuildVersion.swift" "$SOURCE_DIR"/Sources/App/*.swift "$SOURCE_DIR"/Sources/Core/*.swift
}

swiftc --version
echo "Bubblecast version: $APP_VERSION"
if [ "$MODE" = "package" ]; then
    echo "Building the universal (x86_64 + arm64) menu-bar app…"
    compile_for x86_64 "$BUILD_TEMP/Bubblecast-x86_64"
    compile_for arm64 "$BUILD_TEMP/Bubblecast-arm64"
    lipo -create -output "$MACOS_DIR/Bubblecast" "$BUILD_TEMP/Bubblecast-x86_64" "$BUILD_TEMP/Bubblecast-arm64"
    lipo -info "$MACOS_DIR/Bubblecast"
else
    HOST_ARCH="$(uname -m)"
    echo "Building the menu-bar app for $HOST_ARCH…"
    compile_for "$HOST_ARCH" "$MACOS_DIR/Bubblecast"
fi

if [ -n "${RELAY_SIGN_IDENTITY:-}" ]; then
    codesign --force --sign "$RELAY_SIGN_IDENTITY" "$STAGE_APP"
else
    codesign --force --sign - "$STAGE_APP"
fi
codesign --verify --strict "$STAGE_APP"

# ---------------------------------------------------------------------------
# Package mode: universal app plus a drag-to-Applications disk image.
# ---------------------------------------------------------------------------
if [ "$MODE" = "package" ]; then
    DIST_DIR="$REPOSITORY_ROOT/dist"
    DMG_PATH="$DIST_DIR/Bubblecast-$APP_VERSION.dmg"
    DMG_ROOT="$BUILD_TEMP/dmg"
    mkdir -p "$DIST_DIR" "$DMG_ROOT"
    ditto "$STAGE_APP" "$DMG_ROOT/Bubblecast.app"
    ln -s /Applications "$DMG_ROOT/Applications"
    rm -f "$DMG_PATH"
    hdiutil create -volname "Bubblecast $APP_VERSION" -srcfolder "$DMG_ROOT" -fs HFS+ -format UDZO -ov "$DMG_PATH"
    hdiutil verify "$DMG_PATH"
    (cd "$DIST_DIR" && shasum -a 256 "$(basename "$DMG_PATH")" > "$(basename "$DMG_PATH").sha256")
    echo
    echo "Disk image: $DMG_PATH"
    cat "$DMG_PATH.sha256"
    exit 0
fi

# ---------------------------------------------------------------------------
# Install mode: replace ~/Applications/Bubblecast.app safely and launch it.
# ---------------------------------------------------------------------------
APP_DIR="$HOME/Applications/Bubblecast.app"
INSTALL_STAGE="$HOME/Applications/.Bubblecast.stage.$$"
BACKUP_APP="$HOME/Applications/.Bubblecast.previous.$$"
mkdir -p "$HOME/Applications"
trap 'rm -rf "$BUILD_TEMP" "$INSTALL_STAGE"' EXIT
ditto "$STAGE_APP" "$INSTALL_STAGE"

if pgrep -x Bubblecast >/dev/null 2>&1; then
    osascript -e 'tell application id "local.bubblecast" to quit' || true
    for attempt in $(seq 1 30); do
        if ! pgrep -x Bubblecast >/dev/null 2>&1; then break; fi
        sleep 0.5
    done
    if pgrep -x Bubblecast >/dev/null 2>&1; then
        echo "The running Bubblecast app did not quit; the installed app was left unchanged." >&2
        exit 1
    fi
fi

if [ -e "$APP_DIR" ]; then
    mv "$APP_DIR" "$BACKUP_APP"
fi
if ! mv "$INSTALL_STAGE" "$APP_DIR"; then
    if [ -e "$BACKUP_APP" ]; then mv "$BACKUP_APP" "$APP_DIR"; fi
    echo "Could not install the staged app; the previous app was restored." >&2
    exit 1
fi
rm -rf "$BACKUP_APP"

LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
if [ -x "$LSREGISTER" ]; then "$LSREGISTER" -f "$APP_DIR" >/dev/null 2>&1 || true; fi
touch "$APP_DIR"
open "$APP_DIR"
echo
echo "Installed and opened: $APP_DIR"
echo "Running app version: $(defaults read "$APP_DIR/Contents/Info" CFBundleShortVersionString)"
echo "Keep this app at this path after granting Full Disk Access."
